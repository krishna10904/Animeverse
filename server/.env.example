PORT=5000
# Local MongoDB, or paste your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/animeverse
# Set a long random secret before deploying
JWT_SECRET=change-me-to-a-long-random-string
# How often the server checks for new releases (minutes)
POLL_MINUTES=5

# Optional: enable in-page playback of full episodes published by official YouTube channels.
# Create a YouTube Data API v3 key in Google Cloud Console and keep it server-side.
YOUTUBE_API_KEY=
# Defaults to official Muse Asia and Ani-One India channel IDs if omitted.
# Override with comma-separated verified/licensed channel IDs only.
YOUTUBE_OFFICIAL_CHANNEL_IDS=UCGbshtvS9t-8CW11W7TooQg,UC67pLBZ_z4Gd46t6mW7uHjA
